{
  "subsets": [
    "HaluEval",
    "RAGTruth",
    "FinanceBench",
    "DROP",
    "CovidQA",
    "PubMedQA"
  ],
  "n_per_subset": 200,
  "balanced": false,
  "seed": 42,
  "exclude_from": [],
